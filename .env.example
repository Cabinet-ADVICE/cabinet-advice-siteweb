# Production uses .env directly — copy this file and edit on the server:
#   cp .env.example .env && nano .env
#
# VITE_* variables are embedded at BUILD TIME. After any change, rebuild:
#   npm run build

# Public site URL (used for SEO, sitemap, Open Graph)
VITE_SITE_URL=https://cabinet-advice.net

# Branding
VITE_SITE_NAME=Cabinet ADVICE

# Contact details shown on the site
VITE_CONTACT_EMAIL=contact@cabinet-advice.net
VITE_CONTACT_PHONE=+212 X XX XX XX XX
VITE_CONTACT_ADDRESS=Maroc
VITE_WHATSAPP_URL=https://wa.me/212XXXXXXXXX

# Web3Forms — required for the contact form to work
# Get a key at https://web3forms.com
VITE_WEB3FORMS_ACCESS_KEY=
